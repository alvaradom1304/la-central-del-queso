{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aem:threejs-experience:output:0.2.0",
  "title": "threejs-experience result",
  "type": "object",
  "required": [
    "task_id",
    "skill",
    "version",
    "status",
    "result",
    "evidence",
    "assumptions",
    "missing_inputs",
    "validation",
    "next_actions"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "const": "threejs-experience"
    },
    "version": {
      "const": "0.2.0"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "FAILED",
        "BLOCKED",
        "NEEDS_REVIEW"
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "scene_code",
        "loading_plan",
        "fallback"
      ],
      "properties": {
        "scene_code": {
          "type": "object",
          "required": [
            "summary",
            "data",
            "evidence_ids",
            "limitations"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "data": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "artifacts",
                    "version",
                    "commercial_function",
                    "resource_owners"
                  ],
                  "properties": {
                    "artifacts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "commercial_function": {
                      "type": "string",
                      "minLength": 1
                    },
                    "resource_owners": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "resource",
                          "owner",
                          "shared",
                          "release_condition"
                        ],
                        "properties": {
                          "resource": {
                            "type": "string",
                            "minLength": 1
                          },
                          "owner": {
                            "type": "string",
                            "minLength": 1
                          },
                          "shared": {
                            "type": "boolean"
                          },
                          "release_condition": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "loading_plan": {
          "type": "object",
          "required": [
            "summary",
            "data",
            "evidence_ids",
            "limitations"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "data": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "critical_content",
                    "deferred_assets",
                    "budget",
                    "pause_conditions"
                  ],
                  "properties": {
                    "critical_content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "deferred_assets": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "budget": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "metric",
                          "target",
                          "unit",
                          "device_profile"
                        ],
                        "properties": {
                          "metric": {
                            "type": "string",
                            "minLength": 1
                          },
                          "target": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "unit": {
                            "type": "string",
                            "minLength": 1
                          },
                          "device_profile": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "pause_conditions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "fallback": {
          "type": "object",
          "required": [
            "summary",
            "data",
            "evidence_ids",
            "limitations"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "data": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "failure",
                      "behavior",
                      "commercial_task_available",
                      "verification",
                      "artifact"
                    ],
                    "properties": {
                      "failure": {
                        "type": "string",
                        "minLength": 1
                      },
                      "behavior": {
                        "type": "string",
                        "minLength": 1
                      },
                      "commercial_task_available": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "verification": {
                        "enum": [
                          "PASS",
                          "FAIL",
                          "NOT_RUN",
                          "NOT_APPLICABLE"
                        ]
                      },
                      "artifact": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "observed_at",
          "claim",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "FACT",
              "EVIDENCE",
              "INTERPRETATION",
              "HYPOTHESIS",
              "RECOMMENDATION"
            ]
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim": {
            "type": "string"
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "performed",
          "outcome",
          "evidence_ids"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "performed": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCESS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "scene_code": {
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "artifacts",
                      "version",
                      "commercial_function",
                      "resource_owners"
                    ],
                    "properties": {
                      "artifacts": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "version": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "commercial_function": {
                        "type": "string",
                        "minLength": 1
                      },
                      "resource_owners": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "resource",
                            "owner",
                            "shared",
                            "release_condition"
                          ],
                          "properties": {
                            "resource": {
                              "type": "string",
                              "minLength": 1
                            },
                            "owner": {
                              "type": "string",
                              "minLength": 1
                            },
                            "shared": {
                              "type": "boolean"
                            },
                            "release_condition": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "loading_plan": {
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "critical_content",
                      "deferred_assets",
                      "budget",
                      "pause_conditions"
                    ],
                    "properties": {
                      "critical_content": {
                        "type": "string",
                        "minLength": 1
                      },
                      "deferred_assets": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "budget": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "metric",
                            "target",
                            "unit",
                            "device_profile"
                          ],
                          "properties": {
                            "metric": {
                              "type": "string",
                              "minLength": 1
                            },
                            "target": {
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "unit": {
                              "type": "string",
                              "minLength": 1
                            },
                            "device_profile": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "pause_conditions": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "fallback": {
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "failure",
                        "behavior",
                        "commercial_task_available",
                        "verification",
                        "artifact"
                      ],
                      "properties": {
                        "failure": {
                          "type": "string",
                          "minLength": 1
                        },
                        "behavior": {
                          "type": "string",
                          "minLength": 1
                        },
                        "commercial_task_available": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "verification": {
                          "enum": [
                            "PASS",
                            "FAIL",
                            "NOT_RUN",
                            "NOT_APPLICABLE"
                          ]
                        },
                        "artifact": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
