{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "context",
    "inputs",
    "authorized_scope",
    "available_tools",
    "acceptance_criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "context": {
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "required": [
        "ui",
        "contenido",
        "dispositivos",
        "input_modes"
      ],
      "properties": {
        "ui": {
          "description": "UI",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "contenido": {
          "description": "contenido",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "dispositivos": {
          "description": "dispositivos",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "input_modes": {
          "description": "input modes",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "authorized_scope": {
      "type": "object"
    },
    "available_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object"
    }
  },
  "additionalProperties": false
}