{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order Payload Contract",
  "description": "JSON schema for the payload emitted by Next.js to the n8n webhook",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "description": "Unique identifier for the order (e.g. ORD-1234)"
    },
    "customerName": {
      "type": "string"
    },
    "customerPhone": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "unit": {
      "type": "string"
    },
    "totalPriceCRC": {
      "type": "number"
    },
    "pickupLocation": {
      "type": "string",
      "enum": ["Guadalupe", "Hatillo", "Delivery"]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING_CONFIRMATION", "CONFIRMED", "FULFILLED", "CANCELLED"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "orderId",
    "customerName",
    "productId",
    "productName",
    "quantity",
    "unit",
    "totalPriceCRC",
    "pickupLocation",
    "status",
    "createdAt"
  ]
}
