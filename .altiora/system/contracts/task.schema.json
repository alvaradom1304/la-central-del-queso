    "inputs": {"type": "object"},
    "available_tools": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "owned_files": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
