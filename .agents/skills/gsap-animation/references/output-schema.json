{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aem:gsap-animation:output:0.2.0",
  "title": "gsap-animation result",
  "type": "object",
  "required": [
    "task_id",
    "skill",
    "version",
    "status",
    "result",
    "evidence",
    "assumptions",
    "missing_inputs",
    "validation",
    "next_actions"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "const": "gsap-animation"
    },
    "version": {
      "const": "0.2.0"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "FAILED",
        "BLOCKED",
        "NEEDS_REVIEW"
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "animation_code",
        "cleanup",
        "verification"
      ],
      "properties": {
        "animation_code": {
          "type": "object",
          "required": [
            "summary",
            "data",
            "evidence_ids",
            "limitations"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "data": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "artifacts",
                    "version",
                    "root_scope",
                    "motion_states"
                  ],
                  "properties": {
                    "artifacts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "root_scope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "motion_states": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "condition",
                          "behavior",
                          "cta_access"
                        ],
                        "properties": {
                          "condition": {
                            "type": "string",
                            "minLength": 1
                          },
                          "behavior": {
                            "type": "string",
                            "minLength": 1
                          },
                          "cta_access": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "cleanup": {
          "type": "object",
          "required": [
            "summary",
            "data",
            "evidence_ids",
            "limitations"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "data": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "resource",
                      "owner",
                      "create_at",
                      "release_at",
                      "release_method",
                      "verification"
                    ],
                    "properties": {
                      "resource": {
                        "type": "string",
                        "minLength": 1
                      },
                      "owner": {
                        "type": "string",
                        "minLength": 1
                      },
                      "create_at": {
                        "type": "string",
                        "minLength": 1
                      },
                      "release_at": {
                        "type": "string",
                        "minLength": 1
                      },
                      "release_method": {
                        "type": "string",
                        "minLength": 1
                      },
                      "verification": {
                        "enum": [
                          "PASS",
                          "FAIL",
                          "NOT_RUN",
                          "NOT_APPLICABLE"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "required": [
            "summary",
            "data",
            "evidence_ids",
            "limitations"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "data": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "case",
                      "environment",
                      "expected",
                      "observed",
                      "outcome",
                      "artifact"
                    ],
                    "properties": {
                      "case": {
                        "type": "string",
                        "minLength": 1
                      },
                      "environment": {
                        "type": "string",
                        "minLength": 1
                      },
                      "expected": {
                        "type": "string",
                        "minLength": 1
                      },
                      "observed": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "outcome": {
                        "enum": [
                          "PASS",
                          "FAIL",
                          "NOT_RUN",
                          "NOT_APPLICABLE"
                        ]
                      },
                      "artifact": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "observed_at",
          "claim",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "FACT",
              "EVIDENCE",
              "INTERPRETATION",
              "HYPOTHESIS",
              "RECOMMENDATION"
            ]
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim": {
            "type": "string"
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "performed",
          "outcome",
          "evidence_ids"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "performed": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCESS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "animation_code": {
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "artifacts",
                      "version",
                      "root_scope",
                      "motion_states"
                    ],
                    "properties": {
                      "artifacts": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "version": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "root_scope": {
                        "type": "string",
                        "minLength": 1
                      },
                      "motion_states": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "condition",
                            "behavior",
                            "cta_access"
                          ],
                          "properties": {
                            "condition": {
                              "type": "string",
                              "minLength": 1
                            },
                            "behavior": {
                              "type": "string",
                              "minLength": 1
                            },
                            "cta_access": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "cleanup": {
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "resource",
                        "owner",
                        "create_at",
                        "release_at",
                        "release_method",
                        "verification"
                      ],
                      "properties": {
                        "resource": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner": {
                          "type": "string",
                          "minLength": 1
                        },
                        "create_at": {
                          "type": "string",
                          "minLength": 1
                        },
                        "release_at": {
                          "type": "string",
                          "minLength": 1
                        },
                        "release_method": {
                          "type": "string",
                          "minLength": 1
                        },
                        "verification": {
                          "enum": [
                            "PASS",
                            "FAIL",
                            "NOT_RUN",
                            "NOT_APPLICABLE"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              },
              "verification": {
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "case",
                        "environment",
                        "expected",
                        "observed",
                        "outcome",
                        "artifact"
                      ],
                      "properties": {
                        "case": {
                          "type": "string",
                          "minLength": 1
                        },
                        "environment": {
                          "type": "string",
                          "minLength": 1
                        },
                        "expected": {
                          "type": "string",
                          "minLength": 1
                        },
                        "observed": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "outcome": {
                          "enum": [
                            "PASS",
                            "FAIL",
                            "NOT_RUN",
                            "NOT_APPLICABLE"
                          ]
                        },
                        "artifact": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
