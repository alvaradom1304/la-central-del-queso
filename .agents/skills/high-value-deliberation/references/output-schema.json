{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aem:high-value-deliberation:output:0.1.0",
  "title": "High-value deliberation result",
  "type": "object",
  "required": [
    "task_id",
    "skill",
    "version",
    "status",
    "result",
    "evidence",
    "assumptions",
    "missing_inputs",
    "validation",
    "next_actions"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "const": "high-value-deliberation"
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "FAILED",
        "BLOCKED",
        "NEEDS_REVIEW"
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "type": "object",
          "required": [
            "summary",
            "data",
            "evidence_ids",
            "limitations"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "data": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "answer",
                    "recommendation",
                    "changed_by_objections",
                    "facts",
                    "inferences",
                    "uncertainties",
                    "risks",
                    "next_steps",
                    "sources_consulted",
                    "deliverable_status"
                  ],
                  "properties": {
                    "answer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "recommendation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "changed_by_objections": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "inferences": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "uncertainties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "risks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "next_steps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "sources_consulted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "deliverable_status": {
                      "enum": [
                        "NOT_REQUESTED",
                        "COMPLETE",
                        "INCOMPLETE",
                        "BLOCKED"
                      ]
                    },
                    "deliverable_artifacts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "observed_at",
          "claim",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "FACT",
              "EVIDENCE",
              "INTERPRETATION",
              "HYPOTHESIS",
              "RECOMMENDATION"
            ]
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim": {
            "type": "string"
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "performed",
          "outcome",
          "evidence_ids"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "performed": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCESS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "decision": {
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "answer",
                      "recommendation",
                      "changed_by_objections",
                      "facts",
                      "inferences",
                      "uncertainties",
                      "risks",
                      "next_steps",
                      "sources_consulted",
                      "deliverable_status"
                    ],
                    "properties": {
                      "answer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "recommendation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "changed_by_objections": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "facts": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "inferences": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "uncertainties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "risks": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "next_steps": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "sources_consulted": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "deliverable_status": {
                        "enum": [
                          "NOT_REQUESTED",
                          "COMPLETE"
                        ]
                      },
                      "deliverable_artifacts": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
