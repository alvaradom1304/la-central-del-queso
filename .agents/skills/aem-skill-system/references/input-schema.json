    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "context": {
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "required": [
        "objetivo",
        "capacidades_existentes",
        "contexto_disponible",
        "alcance_autorizado"
      ],
      "properties": {
        "objetivo": {
          "description": "objetivo",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "capacidades_existentes": {
          "description": "capacidades existentes",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "contexto_disponible": {
          "description": "contexto disponible",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "alcance_autorizado": {
          "description": "alcance autorizado",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "authorized_scope": {
      "type": "object"
    },
    "available_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
