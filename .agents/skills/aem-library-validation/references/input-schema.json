{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "context",
    "inputs",
    "authorized_scope",
    "available_tools",
    "acceptance_criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "context": {
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "required": [
        "workspace_de_skills",
        "criterios",
        "outputs_de_evaluaci_n",
        "alcance_autorizado"
      ],
      "properties": {
        "workspace_de_skills": {
          "description": "workspace de skills",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "criterios": {
          "description": "criterios",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "outputs_de_evaluaci_n": {
          "description": "outputs de evaluación",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "alcance_autorizado": {
          "description": "alcance autorizado",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "authorized_scope": {
      "type": "object"
    },
    "available_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object"
    }
  },
  "additionalProperties": false
}