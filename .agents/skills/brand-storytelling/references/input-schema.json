            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "prop_sito": {
          "description": "propósito",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "audiencia": {
          "description": "audiencia",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "authorized_scope": {
      "type": "object"
    },
    "available_tools": {
      "type": "array",
